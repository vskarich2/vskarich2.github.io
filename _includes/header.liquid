<header class="site-header">
  <nav
    id="navbar"
    class="navbar navbar-light site-nav {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Primary navigation"
  >
    <div class="container site-nav__inner">
      <a class="navbar-brand site-nav__brand" href="{{ '/' | relative_url }}" aria-label="Veljko Skarich, home">Veljko Skarich</a>

      <button
        class="site-nav__toggle"
        type="button"
        data-site-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="site-nav__menu" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list site-nav__links">
          <li class="nav-item {% if page.url contains '/research/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/research/' | relative_url }}"
              {% if page.url contains '/research/' %}
                aria-current="page"
              {% endif %}
              >Research</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link"
              href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"
              target="_blank"
              rel="me noopener noreferrer"
              >LinkedIn</a
            >
          </li>
        </ul>
        <div class="site-nav__actions">
          <a class="site-nav__icon" href="https://github.com/vskarich2" target="_blank" rel="me noopener noreferrer" aria-label="GitHub profile">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
          {% if site.enable_darkmode %}
            <button id="light-toggle" class="site-nav__theme" type="button" title="Change color theme" aria-label="Change color theme">
              <i class="fa-half-sun-moon" id="light-toggle-system"></i>
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
              <i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>
  <script src="{{ '/assets/js/site-nav.js' | relative_url }}" defer></script>
</header>
